// Additive data layer for Nexora. Shared by the Next.js website and the mobile app.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  ORGANIZER
  JUDGE
}

enum HackathonStatus {
  UPCOMING
  OPEN
  LIVE
  ENDED
}

enum HackathonMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum OtpPurpose {
  VERIFY
  RESET
}

enum AttendanceStatus {
  ACTIVE
  PAUSED
  ENDED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  college       String   @default("")
  passwordHash  String
  role          Role     @default(PARTICIPANT)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())

  otps          Otp[]
  hackathons    Hackathon[]        @relation("Organizer")
  registrations Registration[]
  submissions   Submission[]
  assignments   JudgeAssignment[]
  evaluations   Evaluation[]
  attendance    AttendanceRecord[]
}

model Otp {
  id        String     @id @default(cuid())
  userId    String
  purpose   OtpPurpose
  codeHash  String
  attempts  Int        @default(0)
  expiresAt DateTime
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Hackathon {
  id               String          @id @default(cuid())
  name             String
  college          String          @default("")
  location         String          @default("")
  mode             HackathonMode   @default(ONLINE)
  status           HackathonStatus @default(UPCOMING)
  theme            String          @default("")
  tags             String[]
  description      String          @default("")
  problemStatement String          @default("")
  prize            Int             @default(0)
  currency         String          @default("INR")
  startDate        DateTime
  endDate          DateTime?
  organizerId      String
  createdAt        DateTime        @default(now())

  organizer     User                @relation("Organizer", fields: [organizerId], references: [id])
  registrations Registration[]
  submissions   Submission[]
  judges        JudgeAssignment[]
  sessions      AttendanceSession[]
}

model Registration {
  id          String    @id @default(cuid())
  userId      String
  hackathonId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@unique([userId, hackathonId])
}

// Blind judging: judges only ever see projectCode, never the submitter.
model Submission {
  id          String       @id @default(cuid())
  projectCode String       @unique
  hackathonId String
  userId      String
  title       String
  description String       @default("")
  repoUrl     String       @default("")
  demoUrl     String       @default("")
  createdAt   DateTime     @default(now())
  hackathon   Hackathon    @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluations Evaluation[]

  @@unique([hackathonId, userId])
}

model JudgeAssignment {
  id          String    @id @default(cuid())
  hackathonId String
  judgeId     String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  judge       User      @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([hackathonId, judgeId])
}

model Evaluation {
  id           String     @id @default(cuid())
  submissionId String
  judgeId      String
  score        Int
  comments     String     @default("")
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judge        User       @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([submissionId, judgeId])
}

model AttendanceSession {
  id          String             @id @default(cuid())
  hackathonId String
  status      AttendanceStatus   @default(ACTIVE)
  qrSecret    String
  startedAt   DateTime           @default(now())
  endedAt     DateTime?
  hackathon   Hackathon          @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  records     AttendanceRecord[]

  @@index([hackathonId, status])
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  sessionId String
  userId    String
  createdAt DateTime          @default(now())
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}
